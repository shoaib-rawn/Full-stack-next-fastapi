APP_NAME=LedgerLite API
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
SQL_ECHO=false
# Plain postgresql:// and explicit postgresql+asyncpg:// are both accepted.
DATABASE_URL=postgresql+asyncpg://ledgerlite:ledgerlite_dev_password@localhost:5434/ledgerlite
# Hosted migrations should use Neon's direct (non-pooler) URL.
DATABASE_URL_UNPOOLED=
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
REDIS_URL=redis://localhost:6380/0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
